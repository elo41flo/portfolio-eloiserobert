# Liens ignorés par la vérification automatique (lychee)

# LinkedIn et Instagram bloquent les robots (codes 999 / 429)
linkedin\.com
instagram\.com

# Adresses de "préconnexion" aux polices : la racine du domaine renvoie 404, c'est normal
^https://fonts\.googleapis\.com/?$
^https://fonts\.gstatic\.com/?$

# Formspree n'accepte que l'envoi du formulaire (POST)
formspree\.io

# Liens internes de changement de mode (?mode=classique / ?mode=jeu)
mode=

# Email et téléphone
^mailto:
^tel:
